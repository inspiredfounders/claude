# Copy this file to .env and fill in the values from your Google Cloud OAuth
# client (see README.md for the full step-by-step setup).

# OAuth 2.0 Client ID / Secret from Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID > Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URI" on the OAuth client.
# Keep this as-is for local use; change the host if you deploy elsewhere.
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/callback

# Random long string used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the dashboard server listens on
PORT=8787
